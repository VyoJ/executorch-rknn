# CMake toolchain file for Luckfox Pico (RV1103/RV1106): Cortex-A7, NEON-VFPv4, uClibc.
# Used inside the `cross` container, where LUCKFOX_TOOLCHAIN and LUCKFOX_TRIPLE are set.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7)

if(DEFINED ENV{LUCKFOX_TOOLCHAIN})
  set(LUCKFOX_TOOLCHAIN $ENV{LUCKFOX_TOOLCHAIN})
else()
  set(LUCKFOX_TOOLCHAIN /opt/toolchain)
endif()
if(DEFINED ENV{LUCKFOX_TRIPLE})
  set(LUCKFOX_TRIPLE $ENV{LUCKFOX_TRIPLE})
else()
  set(LUCKFOX_TRIPLE arm-rockchip830-linux-uclibcgnueabihf)
endif()

set(CMAKE_C_COMPILER   ${LUCKFOX_TOOLCHAIN}/bin/${LUCKFOX_TRIPLE}-gcc)
set(CMAKE_CXX_COMPILER ${LUCKFOX_TOOLCHAIN}/bin/${LUCKFOX_TRIPLE}-g++)
set(CMAKE_AR           ${LUCKFOX_TOOLCHAIN}/bin/${LUCKFOX_TRIPLE}-ar CACHE FILEPATH "")
set(CMAKE_RANLIB       ${LUCKFOX_TOOLCHAIN}/bin/${LUCKFOX_TRIPLE}-ranlib CACHE FILEPATH "")
set(CMAKE_STRIP        ${LUCKFOX_TOOLCHAIN}/bin/${LUCKFOX_TRIPLE}-strip CACHE FILEPATH "")

set(CMAKE_SYSROOT ${LUCKFOX_TOOLCHAIN}/${LUCKFOX_TRIPLE}/sysroot)

set(LUCKFOX_ARCH_FLAGS "-march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT   "${LUCKFOX_ARCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${LUCKFOX_ARCH_FLAGS}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
